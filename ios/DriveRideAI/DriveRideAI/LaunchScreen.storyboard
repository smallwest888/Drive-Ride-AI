                                        <rect key="frame" x="82.666666666666671" y="0.0" width="64" height="64"/>
                                        <constraints>
                                            <constraint firstAttribute="height" constant="64" id="launch-icon-height"/>
                                            <constraint firstAttribute="width" constant="64" id="launch-icon-width"/>
                                        </constraints>
